      "id": "평판 조회 (TI)",
      "name": "평판 조회 (TI)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        -420,
        340
      ]
    },
    {
      "parameters": {
        "jsCode": "// ── 로그 헬퍼 ───────────────────────────────────────────────\n// L(...) 로 남긴 기록은 두 곳에서 보인다.\n//   1) 편집 화면에서 이 노드를 실행하면  → 출력 패널의 'Logs' 탭 (console.log)\n//   2) 모든 실행 (프로덕션 포함)         → 출력 데이터의 _log 필드\nconst _log = [];\nconst L = (...a) => {\n  const s = a.map(v => (typeof v === 'object' ? JSON.stringify(v) : String(v))).join(' ');\n  _log.push(s);\n  console.log('[위험도 산정] ' + s);\n};\n// ───────────────────────────────────────────────────────────\n// [판정] 경보 심각도와 외부 평판을 합쳐 위험도를 산정한다.\n// HTTP 노드를 지나면 $json 이 평판 응답으로 바뀌므로, 경보 원본은 이름으로 참조한다.\nconst alert = $('경보 파싱').first().json;\nconst rep   = $json;\n\nconst SEV  = { low: 10, medium: 30, high: 55, critical: 70 };\nconst base = SEV[alert.severity] ?? 30;\n\nL(`경보  : ${alert.rule} · ${alert.host}/${alert.user} · severity=${alert.severity} → 가중치 ${base}`);\nL(`평판  : score=${rep.score} country=${rep.country} asn=${rep.asn} cats=[${(rep.categories || []).join(',')}] internal=${rep.internal === true}`);\n\nconst risk = Math.min(100, Math.round(rep.score * 0.7 + base * 0.5));\nL(`계산  : round(${rep.score} × 0.7 + ${base} × 0.5) = ${risk}`);\n\nconst decision = risk >= 80 ? 'block' : 'close';\nL(`판정  : ${decision}  (임계값 80, 위험도 ${risk})`);\n\nreturn [{\n  json: {\n    ...alert,\n    reputation: rep.score,\n    country: rep.country,\n    asn: rep.asn,\n    categories: (rep.categories || []).join(',') || '-',\n    internal: rep.internal === true,\n    risk_score: risk,\n    decision,\n    rationale: `severity=${alert.severity}(${base}) + reputation=${rep.score} -> risk=${risk}`,\n    _log: [ ...(alert._log || []), ..._log ],\n  }\n}];"
      },
      "id": "위험도 산정",
      "name": "위험도 산정",
      "type": "n8n-nodes-base.code",
