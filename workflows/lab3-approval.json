      "webhookId": "aaaa3333-0000-4000-8000-00000000lab3"
    },
    {
      "parameters": {
        "jsCode": "// ── 로그 헬퍼 ───────────────────────────────────────────────\n// L(...) 로 남긴 기록은 두 곳에서 보인다.\n//   1) 편집 화면에서 이 노드를 실행하면  → 출력 패널의 'Logs' 탭 (console.log)\n//   2) 모든 실행 (프로덕션 포함)         → 출력 데이터의 _log 필드\nconst _log = [];\nconst L = (...a) => {\n  const s = a.map(v => (typeof v === 'object' ? JSON.stringify(v) : String(v))).join(' ');\n  _log.push(s);\n  console.log('[경보 파싱] ' + s);\n};\n// ───────────────────────────────────────────────────────────\n// [수집] SIEM이 보낸 원본 경보를 플레이북이 쓰기 좋은 공통 필드로 정규화한다.\n// 실제 환경에서는 제품마다 필드명이 제각각이라 이 단계가 반드시 필요하다.\nconst a = $json.body ?? $json;\nL('원본 경보 수신:', a);\n\nconst out = {\n  alert_id: a.alert_id ?? ('ALERT-' + Date.now()),\n  rule:     a.rule     ?? 'unknown-rule',\n  severity: String(a.severity ?? 'medium').toLowerCase(),\n  src_ip:   a.src_ip   ?? a.source_ip ?? '0.0.0.0',\n  host:     a.host     ?? '-',\n  user:     a.user     ?? '-',\n  received_at: new Date().toISOString(),\n};\n\nL(`정규화 완료 → rule=${out.rule} severity=${out.severity} src_ip=${out.src_ip} host=${out.host} user=${out.user}`);\nif (out.src_ip === '0.0.0.0') L('!! 경고: src_ip 를 찾지 못했다. 필드명이 다른 SIEM 인지 확인할 것');\n\nreturn [{ json: { ...out, _log } }];"
      },
      "id": "경보 파싱",
      "name": "경보 파싱",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -620,
