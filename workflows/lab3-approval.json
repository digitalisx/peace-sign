    {
      "parameters": {
        "jsCode": "// ── 로그 헬퍼 ───────────────────────────────────────────────\n// L(...) 로 남긴 기록은 두 곳에서 보인다.\n//   1) 편집 화면에서 이 노드를 실행하면  → 출력 패널의 'Logs' 탭 (console.log)\n//   2) 모든 실행 (프로덕션 포함)         → 출력 데이터의 _log 필드\nconst _log = [];\nconst L = (...a) => {\n  const s = a.map(v => (typeof v === 'object' ? JSON.stringify(v) : String(v))).join(' ');\n  _log.push(s);\n  console.log('[승인 대기] ' + s);\n};\n// ───────────────────────────────────────────────────────────\nconst res = $json;\nconst src = $('위험도 산정').first().json;\nconst q = res.query || null;\nL(`대기 대상: ${src.src_ip} · 위험도 ${src.risk_score}`);\nL(q ? `승인 웹훅 수신 → decision=${q.decision}` : '웹훅 응답 없이 재개됨 → 10분 타임아웃');\nL(q && q.decision === 'approve' ? '→ 승인. 차단을 실행한다'\n  : (q ? '→ 거부. 차단하지 않고 종결한다' : '→ 무응답. 기본 동작(차단 안 함) + 에스컬레이션'));\nreturn [{ json: { ...res, _log: [ ...(res._log || []), ..._log ] } }];"
      },
